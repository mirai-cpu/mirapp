    "pv": {
      "label": "ページビュー",
      "positiveFactors": [
        "SEO記事公開 → オーガニック流入増（1記事あたり+50〜150PV/月が目安）",
        "X投稿バズり → SNS流入スパイク（いいね100超で+200〜500PV見込み）",
        "上位表示キーワード増加 → CTR向上でクリック数増"
      ],
      "negativeFactors": [
        "直帰率上昇 → 滞在が浅くリピート率が低下する",
        "SNS流入が少ない（週1本未満の投稿ペース）",
        "記事本数不足（上位表示できるキーワードが少ない）",
        "CTR低下（タイトル・メタディスクリプションの最適化不足）"
      ],
      "paceNote": "現ペースから月間2,000PVへはSEO記事2本追加 + X週2本投稿の両方が必要"
    },
    "xFollowers": {
      "label": "Xフォロワー",
      "positiveFactors": [
        "Tips系・AIツール紹介投稿（週2本以上）でコンスタントに増加",
        "スクリーンショット付きの実演投稿は保存・リポストされやすい",
        "バズった投稿をシリーズ化して流れを維持する"
      ],
      "negativeFactors": [
        "投稿頻度が週1本未満になると伸びが鈍化する",
        "告知・宣伝系投稿の比率が高いと価値提供ゼロに見える",
        "エンゲージメント率が低い（いいね・リプライが少ない）"
      ],
      "paceNote": "残り127人を2.5ヶ月で達成するには月50人増（週12人増）のペースが必要"
    },
    "bounceRate": {
      "label": "直帰率",
      "positiveFactors": [
        "ファーストビューに価値・使い方が明確に伝わる設計",
        "内部リンク（関連ツール・記事）で回遊を促す",
        "ページ読み込み速度が速い（3秒以内）"
      ],
      "negativeFactors": [
        "チュートリアルUX変更が裏目（2ステップ化で直帰率悪化を確認済み）",
        "検索意図とページコンテンツのミスマッチ",
        "モバイル最適化不足・初回訪問時のCTA・誘導が弱い"
      ],
      "paceNote": "MARGINALIA +9pt・TEMPER +11pt悪化。チュートリアル改修が逆効果の可能性が高く早急な原因究明が必要"
    },
    "organicClicks": {
      "label": "オーガニッククリック",
      "positiveFactors": [
        "記事数増加 → 表示回数増 → クリック増",
        "1〜3位獲得でCTRが大幅向上（4位以下の3〜10倍）",
        "タイトルに数字・具体的な言葉を入れるとCTR向上"
      ],
      "negativeFactors": [
        "4〜10位圏内のまま1位を取れないとCTRが低いまま",
        "競合が上位を独占しているキーワードを狙っている",
        "メタディスクリプションが魅力的でない"
